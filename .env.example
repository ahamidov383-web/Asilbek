# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Supabase yoki boshqa PostgreSQL provider uchun
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?schema=public"

# ============================================
# NEXTAUTH (Authentication)
# ============================================
# NextAuth.js uchun maxfiy kalit (kamida 32 belgi)
# Generatsiya: openssl rand -base64 32

NEXTAUTH_SECRET="your-super-secret-key-minimum-32-characters-long"

# Loyiha URL (development uchun localhost, production uchun domen)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# EMAIL (Optional - Password reset uchun)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ============================================
# FILE UPLOAD (Optional - Rasmlar uchun)
# ============================================
# UPLOADTHING_SECRET="your-uploadthing-secret"
# UPLOADTHING_APP_ID="your-app-id"

# ============================================
# ANALYTICS (Optional)
# ============================================
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"
