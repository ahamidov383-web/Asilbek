// prisma/schema.prisma
// Bu fayl documentation uchun - React loyihasida ishlatilmaydi
// Next.js loyihasiga ko'chirish uchun tayyor

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TOURIST)
  createdAt DateTime @default(now())
  agency    Agency?
  requests  Request[]
}

enum Role {
  TOURIST
  AGENCY
  ADMIN
}

model Agency {
  id               String   @id @default(cuid())
  // Multi-language fields
  name_uz          String
  name_ru          String
  name_en          String
  description_uz   String?
  description_ru   String?
  description_en   String?
  logo             String?
  isVerified       Boolean  @default(false)
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  tours            Tour[]
  offers           Offer[]
}

model Tour {
  id               String   @id @default(cuid())
  // Multi-language fields
  title_uz         String
  title_ru         String
  title_en         String
  description_uz   String
  description_ru   String
  description_en   String
  price            Float    // Universal
  availableSeats   Int
  totalSeats       Int      @default(15)
  startDate        DateTime
  endDate          DateTime
  agencyId         String
  agency           Agency   @relation(fields: [agencyId], references: [id])
  requests         Request[]
}

model Request {
  id          String   @id @default(cuid())
  touristId   String
  tourist     User     @relation(fields: [touristId], references: [id])
  tourId      String?
  tour        Tour?    @relation(fields: [tourId], references: [id])
  budget      Float?
  interests   String?
  startDate   DateTime?
  endDate     DateTime?
  status      RequestStatus @default(PENDING)
  offers      Offer[]
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Offer {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id])
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  price       Float
  message     String
  status      OfferStatus @default(PENDING)
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Place {
  id              String   @id @default(cuid())
  // Multi-language fields
  name_uz         String
  name_ru         String
  name_en         String
  description_uz  String?
  description_ru  String?
  description_en  String?
  howToGet_uz     String?
  howToGet_ru     String?
  howToGet_en     String?
  type            String   // Universal (tarjima qilinmaydi)
  workHours       String   // Universal
  latitude        Float
  longitude       Float
  ticketPrice     String?
}

model Restaurant {
  id              String     @id @default(cuid())
  // Multi-language fields
  name_uz         String
  name_ru         String
  name_en         String
  address_uz      String?
  address_ru      String?
  address_en      String?
  cuisineType     String[]   // Universal (tarjima qilinmaydi)
  avgPrice        Float      // Universal
  latitude        Float
  longitude       Float
  menuItems       MenuItem[]
}

model MenuItem {
  id              String     @id @default(cuid())
  // Multi-language fields
  name_uz         String
  name_ru         String
  name_en         String
  description_uz  String?
  description_ru  String?
  description_en  String?
  price           Float      // Universal
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
}

// Transport Routes (Yangi qo'shilgan)
model TransportRoute {
  id        String      @id @default(cuid())
  name      String      // "3-avtobus", "4-avtobus", "17-marshrutka"
  type      String      // "bus", "minibus", "metro"
  from      String      // Boshlang'ich nuqta
  to        String      // Oxirgi nuqta
  price     Float       // Chipta narxi (so'm)
  stops     RouteStop[]
}

model BusStop {
  id        String      @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  routes    RouteStop[]
}

model RouteStop {
  id        String         @id @default(cuid())
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id])
  stopId    String
  stop      BusStop        @relation(fields: [stopId], references: [id])
  order     Int            // Bekat tartib raqami
  
  @@unique([routeId, stopId])
}
